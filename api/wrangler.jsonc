{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vexrate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Twice a day: Visa publishes around 00:00 UTC; the second run retries any failures.
  "triggers": { "crons": ["15 1 * * *", "15 13 * * *"] },
  "vars": {
    // Comma-separated list of origins allowed to call the API (your Vercel URL).
    "ALLOWED_ORIGINS": "https://vexrate.vercel.app,https://vex-rate.vercel.app,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vexrate",
      "database_id": "7a132469-9dd6-4ff0-b89c-345a9b49cbb2",
      "migrations_dir": "migrations"
    }
  ]
}
